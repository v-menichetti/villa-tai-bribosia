# Local browsing works without secrets. Never commit .env.local.
SITE_URL=http://localhost:3000
# Keep false until photos, terms, contact and final domain are approved.
SITE_INDEXABLE=false
# Optional. Leave empty until the owner's contact address is confirmed.
CONTACT_EMAIL=Vmenichetti@hotmail.com
# Neon Postgres connection string (required on Vercel; server-only secret).
DATABASE_URL=
# SQLite fallback for local development or a single persistent-disk server.
DATABASE_PATH=data/villa.sqlite
# Run node scripts/admin-password.mjs and save the generated hash here.
ADMIN_PASSWORD_HASH=
# Transactional mail: a verified sender domain is required.
RESEND_API_KEY=
MAIL_FROM=
# Enable only behind a trusted proxy which REPLACES x-forwarded-for.
TRUST_PROXY=false
